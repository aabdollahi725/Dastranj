    <!-- ==== Report insight card (Dastranj Report Screen.dc.html, revised formula) ====
      The subject is composed first, then slotted into one of the six branch sentences.
      Wording follows the design's `insightText`, adapted for the two agreed calculation changes:
      the reference is the last *completed* month (so the month is named rather than called
      «این ماه»), and a mean is only claimed when at least two months back it up.
    -->
    <string name="report_subject_all">مجموع هزینه‌های شما</string>
    <string name="report_subject_category">هزینهٔ %1$s شما</string>

    <!-- No data at all for the selected year. -->
    <string name="report_insight_no_data">%1$s در این سال ثبت نشده است.</string>

    <!-- Reference month exists, but fewer than two months behind it. -->
    <string name="report_insight_bare_figure">%1$s در %2$s برابر %3$s تومان بوده است.</string>

    <!-- History exists but is entirely zero. -->
    <string name="report_insight_zero_baseline">%1$s پیش از %2$s صفر بوده است.</string>

    <!-- Within 3% of the mean. -->
    <string name="report_insight_level">%1$s در %2$s تقریباً هم‌اندازهٔ میانگین %3$s ماه گذشتهٔ شماست.</string>

    <!-- Meaningfully above or below the mean. -->
    <string name="report_insight_higher">%1$s در %2$s ⁨%3$s⁩٪ بیشتر از میانگین %4$s ماه گذشتهٔ شماست.</string>
    <string name="report_insight_lower">%1$s در %2$s ⁨%3$s⁩٪ کمتر از میانگین %4$s ماه گذشتهٔ شماست.</string>

    <!-- Past year: the lowest month is the useful fact. -->
    <string name="report_insight_lowest">کمترین %1$s در %2$s بوده است.</string>

